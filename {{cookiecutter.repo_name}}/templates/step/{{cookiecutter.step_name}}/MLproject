{%- set params = cookiecutter.parameters.replace(" ", "").split(",") | reject("equalto", "") | reject("equalto", "config_path") | list -%}
name: {{ cookiecutter.step_name }}
python_env: python_env.yaml

entry_points:
  main:
    parameters:
      config_path:
        description: YAML with this step's config section, written by main.py (empty = its section of config.yaml)
        type: string
        default: ""
{%- for name in params %}
      {{ name }}:
        description: ""  # ADD DESCRIPTION
        type: string
{%- endfor %}

    command: >-
      python {{ cookiecutter.script_name }} --config_path {config_path}{% for name in params %} --{{ name }} {{ "{" }}{{ name }}{{ "}" }}{% endfor %}
