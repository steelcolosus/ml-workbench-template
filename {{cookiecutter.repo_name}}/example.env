POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
POSTGRES_DB=mldb
POSTGRES_VOLUME=./data/db


MLFLOW_ARTIFACT_STORE=./data/artifacts
MLFLOW_BACKEND_STORE=localhost
MLFLOW_TRACKING_SERVER_HOST=0.0.0.0
# Port of the MLflow server on your machine (5000 is taken by macOS's AirPlay
# Receiver); clients use MLFLOW_TRACKING_URI
MLFLOW_TRACKING_SERVER_PORT=5050
MLFLOW_TRACKING_URI=http://localhost:5050
# Host headers the MLflow server accepts (it rejects others as a DNS rebinding
# protection): localhost, the mlflow service name for containers, and
# host.docker.internal for containers reaching `make mlflow-server`
MLFLOW_ALLOWED_HOSTS=localhost,localhost:*,127.0.0.1,127.0.0.1:*,mlflow,mlflow:*,host.docker.internal,host.docker.internal:*

AWS_PROFILE={{cookiecutter.aws_profile}}
AWS_BUCKET={{cookiecutter.s3_bucket}}
AWS_REGION={{cookiecutter.aws_region}}

# Local S3 (`docker compose --profile s3-local up -d`). To point the store at it,
# comment out AWS_PROFILE, uncomment the lines below and create the bucket once:
#   aws --endpoint-url http://localhost:9000 s3 mb s3://$AWS_BUCKET
S3_LOCAL_PORT=9000
# AWS_ENDPOINT_URL=http://localhost:9000
# AWS_ACCESS_KEY_ID=testing
# AWS_SECRET_ACCESS_KEY=testing

# Serving (`make serve` and the serving image): the model saved with
# CustomModel.save(store, "<name>") and its store location
SERVING_MODEL_NAME=
SERVING_MODEL_LOCATION=models
SERVING_PORT=8000

# dev, beta, prod
ENV=dev
